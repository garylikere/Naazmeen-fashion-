rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'angelesalex247@gmail.com' ||
        request.auth.token.email == 'admin@aurelia.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products: Publicly readable, writeable only by Admin
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create, update, delete: if isValidId(productId) && isAdmin();
    }

    // Categories: Publicly readable, writeable only by Admin
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow create, update, delete: if isValidId(categoryId) && isAdmin();
    }

    // Orders: Anyone can create an order, customers can view their own, admins can view and update all
    match /orders/{orderId} {
      allow create: if isValidId(orderId);
      allow read: if isValidId(orderId) && (
        isAdmin() || 
        (isSignedIn() && resource.data.customerId == request.auth.uid)
      );
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // Users: Users can read/write their own profile; admins can read all
    match /users/{userId} {
      allow read: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create, update: if isValidId(userId) && isOwner(userId);
      allow delete: if isValidId(userId) && isAdmin();
    }
  }
}
