# GEMINI_API_KEY: Optional if Gemini API features are used
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# FIREBASE CONFIGURATION (OPTIONAL FOR CLOUD FIRESTORE INTEGRATION)
# If provided, the app will sync with your live Firebase project;
# otherwise, it seamlessly utilizes the built-in persistent storage engine.
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
